# ==============================================================================
# ClinicFlow Environment Configuration Template (.env.example)
# ==============================================================================

# Supabase Session Pooler / PostgreSQL Settings
# Replace with your actual credentials in your private local .env file.
# Format: jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.[PROJECT_REF]
SPRING_DATASOURCE_PASSWORD=your_secure_supabase_password

# Database Driver & Hibernate Behavior
# 'update' preserves existing tables and schema data
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Server Port
PORT=8080

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B59703645
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
